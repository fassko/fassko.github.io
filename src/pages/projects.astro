---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Projects from '@/components/Projects.astro';
---

<BaseLayout
  title="Projects"
  description="Selected work across Flare, x402 payments, AI agents, and iOS — demos, open-source tools, and product builds by Kristaps Grinbergs."
>
  <Header selectedSection="projects" />
  <div class="wrapper">
    <section class="blog-list">
      <h1 class="page-title">Projects</h1>
      <Projects filterable layout="page" />
    </section>
  </div>
  <Footer />
</BaseLayout>
