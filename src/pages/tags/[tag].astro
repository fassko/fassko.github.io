---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import TagList from '@/components/TagList.astro';
import { postSlug } from '@/utils/post';
import { slugifyTag } from '@/utils/tag';
import { seoDescription } from '@/utils/seo';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const tagMap = new Map<string, { label: string; posts: typeof posts }>();

  for (const post of posts) {
    for (const tag of post.data.tags ?? []) {
      const key = slugifyTag(tag);
      const existing = tagMap.get(key) ?? { label: tag, posts: [] };
      // Prefer lowercase label without punctuation for display consistency
      if (!tagMap.has(key)) {
        existing.label = key.replace(/-/g, ' ');
      }
      existing.posts.push(post);
      tagMap.set(key, existing);
    }
  }

  return [...tagMap.entries()].map(([slug, { label, posts: taggedPosts }]) => ({
    params: { tag: slug },
    props: {
      tag: label,
      posts: taggedPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
    },
  }));
}

const { tag, posts } = Astro.props;

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}

const samples = posts
  .slice(0, 2)
  .map((post) => post.data.title)
  .join('; ');
const tagDescription = seoDescription(
  `${posts.length} ${posts.length === 1 ? 'post' : 'posts'} on ${tag} by Kristaps Grinbergs` +
    (samples ? `: ${samples}` : '') +
    `. Notes on web3, AI agents, Swift/iOS, and building products.`,
);
---

<BaseLayout
  title={`Tagged with ${tag}`}
  description={tagDescription}
  noindex={posts.length < 3}
>
  <Header />
  <div class="wrapper">
    <section class="tags">
      <h1 class="page-title">
        Tagged with <span class="tag-title">{tag}</span>
      </h1>
      <a class="browse-all-tags" href="/tags/">Browse all tags</a>
      {
        posts.map((post) => (
          <div class="blog-item">
            <h2>
              <a class="blog-title" href={`/blog/${postSlug(post)}/`}>
                {post.data.title}
              </a>
            </h2>
            <div class="blog-date">
              <TagList tags={post.data.tags ?? []} />
              {formatDate(post.data.date)}
            </div>
            <div class="blog-content">
              <p>{post.data.description}</p>
            </div>
            <a class="blog-read-more" href={`/blog/${postSlug(post)}/`}>
              Read more
            </a>
          </div>
        ))
      }
    </section>
  </div>
  <Footer />
</BaseLayout>
