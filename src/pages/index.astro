---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Hero from '@/components/Hero.astro';
import Divider from '@/components/Divider.astro';
import SocialItems from '@/components/SocialItems.astro';
import Projects from '@/components/Projects.astro';
---

<BaseLayout>
  <Header />
  <div class="wrapper">
    <Hero />
  </div>
  <Divider title="about" />
  <div class="wrapper">
    <section class="about">
      <div class="text">
        <p class="text-paragraph">
          Builds at the intersection of AI, crypto and blockchain — from Solidity smart contracts and
          NFT protocols to product systems that put on-chain value to work.
        </p>
        <p class="text-paragraph">
          Technical co-founder at
          <a href="https://www.qminder.com" target="_blank" rel="noopener noreferrer">Qminder</a>,
          scaled globally with customers like Bolt, Uber, Lyft and The Olympic Games.
        </p>
        <p class="text-paragraph">
          Writes and speaks about Ethereum, DeFi primitives, account abstraction and practical AI for
          builders. Mentors teams shipping Web3 and AI products.
        </p>
      </div>
      <SocialItems />
    </section>
  </div>
  <Divider title="hire me" />
  <div class="wrapper">
    <section class="hire">
      <div class="text">
        <p class="text-paragraph">
          Available for CTO and hands-on product roles in AI, crypto and blockchain — smart contract
          architecture, Web3 product development, and bringing applied AI into real products. Reach
          out to talk about your venture.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="mailto:fassko@gmail.com">Email me</a>
          <a class="button button-ghost" href="/about">About</a>
        </div>
      </div>
    </section>
  </div>
  <Divider title="projects" />
  <div class="wrapper">
    <Projects />
  </div>
  <Footer />
</BaseLayout>
