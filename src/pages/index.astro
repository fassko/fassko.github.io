---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Hero from '@/components/Hero.astro';
import Divider from '@/components/Divider.astro';
import SocialItems from '@/components/SocialItems.astro';
import Projects from '@/components/Projects.astro';
---

<BaseLayout>
  <Header />
  <div class="wrapper">
    <Hero />
  </div>
  <Divider title="about" />
  <div class="wrapper">
    <section class="about">
      <div class="text">
        <p class="text-paragraph">
          Executed as co-founder at global scale company
          <a href="https://www.qminder.com" target="_blank" rel="noopener noreferrer">Qminder</a>
          that serviced companies like Bolt, Uber, Lyft, The Olympic Games
        </p>
        <p class="text-paragraph">
          He has extensive knowledge and expertise in building projects across full-stack, mobile,
          and blockchain domains.
        </p>
        <p class="text-paragraph">
          His interests are in Web 3.0, sustainability, and automating old and clunky processes.
        </p>
        <p class="text-paragraph">Kristaps hobbies are orienteering sport, cycling and gardening.</p>
      </div>
      <SocialItems />
    </section>
  </div>
  <Divider title="hire me" />
  <div class="wrapper">
    <section class="hire">
      <div class="text">
        <p class="text-paragraph">
          Hire me to assist with CTO roles, as well as product development in full-stack, mobile, and
          blockchain projects. Please reach out for more details and to discuss how I can contribute
          to your venture.
        </p>
      </div>
    </section>
  </div>
  <Divider title="projects" />
  <div class="wrapper">
    <Projects />
  </div>
  <Footer />
</BaseLayout>
