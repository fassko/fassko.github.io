---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Hero from '@/components/Hero.astro';
import Projects from '@/components/Projects.astro';
import { projects } from '@/data/projects';
import { postSlug } from '@/utils/post';

const featuredTitles = ['Flare · FAssets', 'Salto X', 'Dodies.lv', 'Docs agent'];
const featured = featuredTitles
  .map((title) => projects.find((project) => project.title === title))
  .filter((project): project is (typeof projects)[number] => Boolean(project));
const recentPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);
---

<BaseLayout>
  <Header />
  <div class="wrapper">
    <Hero />
  </div>
  <div class="wrapper home-projects">
    <Projects items={featured} showAllLink />
  </div>
  <div class="wrapper home-blog">
    <div class="home-projects-header">
      <p class="section-label">Blog</p>
      <a href="/blog">All posts →</a>
    </div>
    <div class="home-blog-list">
      {
        recentPosts.map((post) => (
          <a class="home-blog-item" href={`/blog/${postSlug(post)}`}>
            {post.data.title}
          </a>
        ))
      }
    </div>
  </div>
  <Footer />
</BaseLayout>
