---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SocialItems from '@/components/SocialItems.astro';
import Lightbox from '@/components/Lightbox.astro';
import { personJsonLd } from '@/utils/jsonld';

const timeline = [
  {
    role: 'DevRel Engineer Lead',
    org: 'Flare Network',
    href: 'https://flare.network',
    when: '2023 — present',
    copy: 'FAssets, x402 integrations, Flare AI Skills, and developer education.',
  },
  {
    role: 'Smart contracts & product',
    org: 'Salto X',
    href: 'https://saltox.co',
    when: '2022 — 2023',
    copy: 'Tokenised employee ownership — Solidity on Polygon and a Next.js client.',
  },
  {
    role: 'Technical co-founder',
    org: 'Qminder',
    href: 'https://www.qminder.com',
    when: 'earlier',
    copy: 'Queue management at global scale — Bolt, Uber, Lyft and The Olympic Games.',
  },
];

const gallery = [
  {
    src: '/assets/speaking/kristaps-grinbergs-dappcon26.jpg',
    alt: 'Kristaps speaking at DappCon',
  },
  {
    src: '/assets/speaking/kristaps-grinbergs-w3n25.jpg',
    alt: 'Panel discussion at W3N',
  },
  {
    src: '/assets/speaking/kristaps-grinbergs-w3n25-2.jpg',
    alt: 'On stage with fellow panelists at W3N',
  },
  {
    src: '/assets/speaking/kristaps-grinbergs-appbuilders.jpeg',
    alt: 'Kristaps speaking at App Builders',
  },
  {
    src: '/assets/speaking/kristaps-grinbergs-nft-tallinn.jpeg',
    alt: 'Kristaps presenting at NFT Tallinn',
  },
  {
    src: '/assets/speaking/kristaps-grinbergs-nft-tallinn-panel.jpg',
    alt: 'Panel at NFT Tallinn',
  },
  {
    src: '/assets/speaking/kristaps-grinbergs-mobile-era.jpg',
    alt: 'Talk at Mobile Era',
  },
  {
    src: '/assets/speaking/kristaps-grinbergs-shareit.jpg',
    alt: 'ShareIT workshop',
  },
  {
    src: '/assets/speaking/kristaps-grinbergs-ethcc24.jpg',
    alt: 'Kristaps at EthCC',
  },
];
---

<BaseLayout
  title="About"
  description="About Kristaps Grinbergs — DevRel at Flare Network, working on x402 payments, AI agents, and Web3."
  jsonLd={personJsonLd()}
>
  <Header selectedSection="about" />
  <div class="wrapper">
    <section class="about-me">
      <div class="about-top">
        <div class="about-me-text">
        <h1 class="page-title">About</h1>
        <p>
          Kristaps is Developer Relations Engineer Lead at{' '}
          <a href="https://flare.network" target="_blank" rel="noopener noreferrer">Flare Network</a>
          {' '}(since Sep 2023). Flare brings assets, data and accounts from other chains onto a single
          smart contract layer, through four core products:
          <a href="https://flare.network/products/fassets" target="_blank" rel="noopener noreferrer"
            >FAssets</a
          > (trustless bridging for non-smart-contract assets like Bitcoin and XRP), the
          <a
            href="https://flare.network/products/flare-data-connector"
            target="_blank"
            rel="noopener noreferrer">Flare Data Connector</a
          > (verified external data on-chain),
          <a
            href="https://flare.network/products/flare-smart-accounts"
            target="_blank"
            rel="noopener noreferrer">Flare Smart Accounts</a
          > (DeFi access straight from an XRPL wallet) and
          <a href="https://dev.flare.network/fcc/overview" target="_blank" rel="noopener noreferrer"
            >Flare Confidential Compute</a
          > (TEE-based off-chain computation and attestation).
        </p>
        <p>
          Before Flare, he spent a decade as co-founder and technical lead at
          <a href="https://www.qminder.com" target="_blank" rel="noopener noreferrer">Qminder</a>,
          building queue management software used by Bolt, Uber, Lyft and the Olympic Games.
        </p>
        <p>
          Day to day he builds and tests developer tooling across Flare's products, fixes bugs,
          writes participant guides and documentation, and maintains Docker-based service setups.
          He works with C-level, engineering, marketing, design and ecosystem stakeholders —
          increasingly on AI agents,
          <a
            href="https://dev.flare.network/fxrp/token-interactions/x402-payments"
            target="_blank"
            rel="noopener noreferrer">x402</a
          >
          payment integrations, and
          <a
            href="https://dev.flare.network/network/guides/flare-ai-skills"
            target="_blank"
            rel="noopener noreferrer">Flare AI Skills</a
          >
          plus related agent projects that help coding assistants build on Flare. He also speaks at
          industry events, runs hackathon tracks, and explains it all through blogs, videos and
          conference demos.
        </p>
        <p>
          He mentors through
          <a href="https://www.startuphouse.lv/preaccelerator" target="_blank" rel="noopener noreferrer"
            >Startup House</a
          >
          and volunteers with
          <a href="https://www.dzivniekubriviba.lv/" target="_blank" rel="noopener noreferrer"
            >Animal Freedom</a
          >
          and others. Hobbies: orienteering, cycling and gardening.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="mailto:fassko@gmail.com">Get in touch →</a>
          <a class="button button-ghost" href="/projects/">See the projects</a>
        </div>
      </div>

      <div class="about-portrait-col">
        <picture>
          <source srcset="/images/kristaps.webp" type="image/webp" />
          <img
            class="about-portrait"
            src="/images/kristaps.jpg"
            alt="Kristaps Grinbergs"
            width="680"
            height="680"
            loading="lazy"
            decoding="async"
          />
        </picture>
      </div>
      </div>

      <div class="about-me-images">
        {
          gallery.map((shot) => (
            <img src={shot.src} alt={shot.alt} loading="lazy" />
          ))
        }
      </div>

      <div class="about-timeline">
        <p class="section-label">Timeline</p>
        <ol class="timeline-list">
          {
            timeline.map((item) => (
              <li>
                <p class="timeline-when">{item.when}</p>
                <p class="timeline-role">
                  {item.role} ·
                  <a href={item.href} target="_blank" rel="noopener noreferrer">
                    {item.org}
                  </a>
                </p>
                <p class="timeline-copy">{item.copy}</p>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="about-me-social-items">
        <SocialItems />
      </div>
    </section>
  </div>
  <Footer />
  <Lightbox />
</BaseLayout>
