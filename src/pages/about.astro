---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SocialItems from '@/components/SocialItems.astro';
---

<BaseLayout title="About">
  <Header selectedSection="about" />
  <div class="wrapper">
    <section class="about-me">
      <div class="about-me-text">
        <h1 class="page-title">About</h1>
        <p>
          Kristaps is Developer Relations Engineer Lead at
          <a href="https://flare.network" target="_blank" rel="noopener noreferrer">Flare Network</a>
          (since Sep 2023). Flare enables smart contracts and cross-chain interoperability for
          blockchains like Bitcoin and XRP, with secure communication and DeFi capabilities.
        </p>
        <p>
          His focus is <strong>FAssets</strong> — Flare’s cornerstone product that lets assets from
          non-smart-contract chains be used trustlessly on Flare. He runs technical beta processes,
          onboards FAssets system agents, and has managed closed betas with 50+ community
          participants and open betas with thousands of users.
        </p>
        <p>
          Day to day he tests FAssets algorithms and tooling, fixes bugs, writes participant guides
          for multiple system roles, maintains Docker-based service setups, and works with C-level,
          engineering, marketing, design and ecosystem stakeholders. He also speaks at industry
          events, supports Flare-sponsored hackathon tracks, and explains FAssets through blogs,
          videos and conference demos — including an app that shows on-chain token prices and the
          math behind the system.
        </p>
        <p>
          Before Flare he built Solidity and full-stack products at
          <a href="https://saltox.co" target="_blank" rel="noopener noreferrer">Salto X</a>, and was
          technical co-founder at
          <a href="https://www.qminder.com" target="_blank" rel="noopener noreferrer">Qminder</a>,
          which scaled globally with customers like Bolt, Uber, Lyft and The Olympic Games.
        </p>
        <p>
          He mentors through
          <a href="http://www.rigatechgirls.com/" target="_blank" rel="noopener noreferrer"
            >Riga Tech Girls</a
          >
          and volunteers with
          <a href="https://www.dzivniekubriviba.lv/" target="_blank" rel="noopener noreferrer"
            >Animal Freedom</a
          >
          and others. Hobbies: orienteering, cycling and gardening.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="mailto:fassko@gmail.com">Email me</a>
          <a class="button button-ghost" href="/blog">Read the blog</a>
        </div>
      </div>
      <div class="about-me-social-items">
        <SocialItems />
      </div>
      <div class="about-me-images">
        <img src="/assets/speaking/kristaps-grinbergs-appbuilders.jpeg" alt="" />
        <img src="/assets/speaking/kristaps-grinbergs-nft-tallinn.jpeg" alt="" />
        <img src="/assets/speaking/kristaps-grinbergs-nft-tallinn-panel.jpg" alt="" />
        <img src="/assets/speaking/kristaps-grinbergs-mobile-era.jpg" alt="" />
        <img src="/assets/speaking/kristaps-grinbergs-shareit.jpg" alt="" />
      </div>
    </section>
  </div>
  <Footer />
</BaseLayout>
