---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SocialItems from '@/components/SocialItems.astro';
---

<BaseLayout title="About">
  <Header selectedSection="about" />
  <div class="wrapper">
    <section class="about-me">
      <div class="about-me-text">
        <h1 class="page-title">About</h1>
        <p>
          Kristaps builds products and protocols across AI, crypto and blockchain — Solidity smart
          contracts, token standards, NFT infrastructure and applied AI systems.
        </p>
        <p>
          Technical co-founder at
          <a href="https://www.qminder.com" target="_blank" rel="noopener noreferrer">Qminder</a>,
          a company that scaled globally with customers like Bolt, Uber, Lyft and The Olympic Games.
        </p>
        <p>
          An active Web3 community member, he writes about Ethereum, DeFi, account abstraction and
          crypto engineering, and speaks at blockchain conferences and meetups. He also teaches and
          mentors founders and engineers shipping AI and on-chain products.
        </p>
        <p>
          Current focus: practical AI for builders, smart contract security and design, and products
          that connect crypto rails to real-world use.
        </p>
        <p>
          Kristaps volunteers with organizations like
          <a href="http://www.rigatechgirls.com/" target="_blank" rel="noopener noreferrer"
            >Riga Tech Girls</a
          >,
          <a href="https://www.dzivniekubriviba.lv/" target="_blank" rel="noopener noreferrer"
            >Animal Freedom</a
          >, and others.
        </p>
        <p>Hobbies: orienteering, cycling and cooking.</p>
      </div>
      <div class="about-me-social-items">
        <SocialItems />
      </div>
      <div class="about-me-images">
        <img src="/assets/speaking/kristaps-grinbergs-appbuilders.jpeg" alt="" />
        <img src="/assets/speaking/kristaps-grinbergs-nft-tallinn.jpeg" alt="" />
        <img src="/assets/speaking/kristaps-grinbergs-nft-tallinn-panel.jpg" alt="" />
        <img src="/assets/speaking/kristaps-grinbergs-mobile-era.jpg" alt="" />
        <img src="/assets/speaking/kristaps-grinbergs-shareit.jpg" alt="" />
      </div>
    </section>
  </div>
  <Footer />
</BaseLayout>
