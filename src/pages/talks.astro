---
import talks from '@/data/talks';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Lightbox from '@/components/Lightbox.astro';
import { siteConfig } from '@/site.config';
import { eventJsonLd, personJsonLd } from '@/utils/jsonld';

function formatDate(dateString: string): string {
  return new Date(dateString).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}

const gallery = [
  {
    src: '/assets/speaking/kristaps-grinbergs-dappcon26.jpg',
    alt: 'Kristaps speaking at DappCon',
  },
  {
    src: '/assets/speaking/kristaps-grinbergs-w3n25.jpg',
    alt: 'Panel discussion at W3N',
  },
  {
    src: '/assets/speaking/kristaps-grinbergs-w3n25-2.jpg',
    alt: 'On stage with fellow panelists at W3N',
  },
  {
    src: '/assets/speaking/kristaps-grinbergs-appbuilders.jpeg',
    alt: 'Kristaps on stage at App Builders',
  },
  {
    src: '/assets/speaking/kristaps-grinbergs-nft-tallinn.jpeg',
    alt: 'Kristaps speaking at NFT Tallinn',
  },
  {
    src: '/assets/speaking/kristaps-grinbergs-nft-tallinn-panel.jpg',
    alt: 'Panel discussion at NFT Tallinn',
  },
  {
    src: '/assets/speaking/kristaps-grinbergs-mobile-era.jpg',
    alt: 'Talk at Mobile Era',
  },
  {
    src: '/assets/speaking/kristaps-grinbergs-shareit.jpg',
    alt: 'Workshop session at ShareIT',
  },
  {
    src: '/assets/speaking/kristaps-grinbergs-ethcc24.jpg',
    alt: 'Kristaps at EthCC',
  },
];
const jsonLd = [personJsonLd(), ...talks.map((talk) => eventJsonLd(talk))];
---

<BaseLayout
  title="Talks"
  description="Talks and workshops on x402, AI agents, TEEs, smart contracts, and developer relations."
  jsonLd={jsonLd}
>
  <Header selectedSection="talks" />
  <div class="wrapper">
    <section class="talks">
      <h1 class="page-title">Talks</h1>
      <div class="hero-actions">
        <a class="button button-primary" href={`mailto:${siteConfig.email}`}>Get in touch →</a>
      </div>
      <p class="section-label talks-gallery-label">Photography from stages and workshops</p>
      <div class="talks-gallery">
        {
          gallery.map((shot) => (
            <img src={shot.src} alt={shot.alt} loading="lazy" />
          ))
        }
      </div>

      <p class="section-label talks-all-label">All talks</p>
      {
        talks.map((talk) => (
          <div class="talk-item">
            <h2 class="talk-title">{talk.title}</h2>
            <div class="talk-date">
              {formatDate(talk.date)} | {talk.event}
            </div>
            {talk.description && <p class="talk-description">{talk.description}</p>}
            {talk.video && (
              <>
                <h3>Video</h3>
                <div class="talk-media">
                  <iframe
                    class="talk-vide-iframe"
                    src={talk.video}
                    title={talk.title}
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                  />
                </div>
              </>
            )}
            {talk.slides && (
              <>
                <h3>Slides</h3>
                <div class="talk-media">
                  <script
                    async
                    class="speakerdeck-embed"
                    data-id={talk.slides}
                    data-ratio="1.77777777777778"
                    src="//speakerdeck.com/assets/embed.js"
                  />
                </div>
              </>
            )}
            {talk.audio && (
              <>
                <h3>Audio</h3>
                <div class="talk-media">
                  <audio controls src={talk.audio} />
                </div>
              </>
            )}
            {talk.image && (
              <>
                <h3>Images</h3>
                <div class="talk-media">
                  <img class="talk-image" src={`/assets/${talk.image}`} alt={talk.title} />
                </div>
              </>
            )}
            {talk.link && (
              <>
                <h3>Links</h3>
                <div class="talk-media">
                  <a href={talk.link.href} target="_blank" rel="noopener noreferrer">
                    {talk.link.text}
                  </a>
                </div>
              </>
            )}
          </div>
        ))
      }
    </section>
  </div>
  <Footer />
  <Lightbox />
</BaseLayout>
