---
import talks from '@/data/talks';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

function formatDate(dateString: string): string {
  return new Date(dateString).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}
---

<BaseLayout title="Talks">
  <Header selectedSection="talks" />
  <div class="wrapper">
    <section class="talks">
      <h1 class="page-title">Talks</h1>
      {
        talks.map((talk) => (
          <div class="talk-item">
            <h2 class="talk-title">{talk.title}</h2>
            <div class="talk-date">
              {formatDate(talk.date)} | {talk.event}
            </div>
            {talk.video && (
              <>
                <h3>Video</h3>
                <div class="talk-media">
                  <iframe
                    class="talk-vide-iframe"
                    src={talk.video}
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                  />
                </div>
              </>
            )}
            {talk.slides && (
              <>
                <h3>Slides</h3>
                <div class="talk-media">
                  <script
                    async
                    class="speakerdeck-embed"
                    data-id={talk.slides}
                    data-ratio="1.77777777777778"
                    src="//speakerdeck.com/assets/embed.js"
                  />
                </div>
              </>
            )}
            {talk.audio && (
              <>
                <h3>Audio</h3>
                <div class="talk-media">
                  <audio controls src={talk.audio} />
                </div>
              </>
            )}
            {talk.image && (
              <>
                <h3>Images</h3>
                <div class="talk-media">
                  <img class="talk-image" src={`/assets/${talk.image}`} alt={talk.title} />
                </div>
              </>
            )}
            {talk.link && (
              <>
                <h3>Links</h3>
                <div class="talk-media">
                  <a href={talk.link.href} target="_blank" rel="noopener noreferrer">
                    {talk.link.text}
                  </a>
                </div>
              </>
            )}
          </div>
        ))
      }
    </section>
  </div>
  <Footer />
</BaseLayout>
