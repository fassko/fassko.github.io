---
import { slugifyTag } from '@/utils/tag';

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="blog-tags">
      {tags.map((tag) => (
        <li>
          <a href={`/tags/${slugifyTag(tag)}/`}>{tag}</a>
        </li>
      ))}
    </ul>
  )
}
