---
import { projects } from '@/data/projects';
import type { Project } from '@/data/projects';
import Divider from '@/components/Divider.astro';
import ProjectCard from '@/components/ProjectCard.astro';

interface Props {
  items?: Project[];
  showAllLink?: boolean;
  filterable?: boolean;
  layout?: 'home' | 'page';
}

const { items = projects, showAllLink = false, filterable = false, layout = 'page' } = Astro.props;

const [featured, ...rest] = items;
const featuredVariant = layout === 'home' ? 'featured' : 'featured-wide';
const secondaryVariant = layout === 'home' ? 'row' : 'grid';
const gridClass = layout === 'home' ? 'home-projects-grid' : 'projects-grid';
---

{
  showAllLink && (
    <Divider title="Selected projects" href="/projects/" />
  )
}

{
  filterable && (
    <div class="project-filters" data-project-filters>
      <button type="button" class="project-filter is-active" data-filter="all" aria-pressed="true">
        all
      </button>
      <button type="button" class="project-filter" data-filter="web3" aria-pressed="false">
        web3
      </button>
      <button type="button" class="project-filter" data-filter="ai" aria-pressed="false">
        ai
      </button>
      <button type="button" class="project-filter" data-filter="ios" aria-pressed="false">
        ios
      </button>
    </div>
  )
}

<section class="projects" data-projects>
  <div class={gridClass}>
    {featured && <ProjectCard project={featured} variant={featuredVariant} />}
    {
      layout === 'home' ? (
        <div class="home-projects-list">
          {rest.map((project) => (
            <ProjectCard project={project} variant={secondaryVariant} />
          ))}
        </div>
      ) : (
        rest.map((project) => <ProjectCard project={project} variant={secondaryVariant} />)
      )
    }
  </div>
</section>

{
  filterable && (
    <script is:inline>
      (() => {
        const root = document.querySelector('[data-project-filters]');
        const list = document.querySelector('[data-projects]');
        if (!root || !list) return;

        const buttons = [...root.querySelectorAll('[data-filter]')];
        const items = [...list.querySelectorAll('.project-card')];

        function apply(filter) {
          buttons.forEach((button) => {
            const active = button.getAttribute('data-filter') === filter;
            button.classList.toggle('is-active', active);
            button.setAttribute('aria-pressed', active ? 'true' : 'false');
          });

          items.forEach((item) => {
            const categories = (item.getAttribute('data-categories') || '')
              .split(/\s+/)
              .filter(Boolean);
            const show = filter === 'all' || categories.includes(filter);
            item.hidden = !show;
          });
        }

        root.addEventListener('click', (event) => {
          const target = event.target.closest('[data-filter]');
          if (!target) return;
          apply(target.getAttribute('data-filter'));
        });
      })();
    </script>
  )
}
