---
interface Props {
  title: string;
  href: string;
  count?: number;
}

const { title, href, count } = Astro.props;
---

<div class="section-divider">
  <a class="section-divider-label" href={href}>{title}</a>
  <a class="section-divider-link" href={href}>{count !== undefined ? `all ${count} →` : 'all →'}</a>
</div>
