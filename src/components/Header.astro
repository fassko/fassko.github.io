---
import ThemeToggle from '@/components/ThemeToggle.astro';

interface Props {
  selectedSection?: 'projects' | 'blog' | 'talks' | 'about' | null;
}

const { selectedSection = null } = Astro.props;
const pathname = Astro.url.pathname;

const links = [
  { href: '/', label: '/home', id: null as null },
  { href: '/projects/', label: '/projects', id: 'projects' as const },
  { href: '/blog/', label: '/blog', id: 'blog' as const },
  { href: '/talks/', label: '/talks', id: 'talks' as const },
  { href: '/about/', label: '/about', id: 'about' as const },
];

function isCurrent(id: (typeof links)[number]['id']): boolean {
  if (id === null) return pathname === '/' || pathname === '';
  return selectedSection === id || pathname.startsWith(`/${id}`);
}
---

<header class="header">
  <div class="header-wrapper">
    <div class="main-title">
      <a href="/">Kristaps Grinbergs</a>
    </div>
    <button
      type="button"
      class="nav-toggle"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Open menu"
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
    <nav class="nav-container" id="site-nav" data-nav aria-label="Primary">
      <ul class="nav">
        {
          links.map((link) => (
            <li class="nav-item">
              <a href={link.href} aria-current={isCurrent(link.id) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ThemeToggle />
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const toggle = document.querySelector('[data-nav-toggle]');
    const nav = document.querySelector('[data-nav]');
    if (!toggle || !nav) return;

    function setOpen(open) {
      document.documentElement.classList.toggle('nav-open', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    }

    toggle.addEventListener('click', () => {
      setOpen(!document.documentElement.classList.contains('nav-open'));
    });

    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  })();
</script>
