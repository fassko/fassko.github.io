---
interface Props {
  selectedSection?: 'blog' | 'talks' | 'about' | null;
}

const { selectedSection = null } = Astro.props;
const pathname = Astro.url.pathname;

const links = [
  { href: '/', label: 'home', id: null as null },
  { href: '/blog', label: 'blog', id: 'blog' as const },
  { href: '/talks', label: 'talks', id: 'talks' as const },
  { href: '/about', label: 'about', id: 'about' as const },
];

function isCurrent(id: typeof links[number]['id']): boolean {
  if (id === null) return pathname === '/' || pathname === '';
  return selectedSection === id;
}
---

<header class="header">
  <div class="header-wrapper">
    <div class="main-title">
      <a href="/">Kristaps Grinbergs</a>
    </div>
    <nav class="nav-container" aria-label="Primary">
      <ul class="nav">
        {
          links.map((link) => (
            <li class="nav-item">
              <a href={link.href} aria-current={isCurrent(link.id) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
