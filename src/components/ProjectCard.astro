---
import type { Project } from '@/data/projects';
import { isExternalProjectHref, projectHref } from '@/data/projects';

interface Props {
  project: Project;
  variant: 'featured' | 'featured-wide' | 'row' | 'grid';
}

const { project, variant } = Astro.props;
const href = projectHref(project);
const external = isExternalProjectHref(project);
const image = project.image ? `/images/${project.image}` : undefined;

function isAppStoreLink(link?: string): boolean {
  if (!link) return false;
  return link.includes('apps.apple.com') || link.includes('itunes.apple.com');
}

function inlineMarkdownLinks(text: string): string {
  const escaped = text
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;');

  return escaped.replace(
    /\[([^\]]+)\]\((https?:\/\/[^)\s]+|\/[^)\s]+)\)/g,
    (_match, label: string, link: string) => {
      const isExternal = link.startsWith('http://') || link.startsWith('https://');
      const attrs = isExternal ? ' target="_blank" rel="noopener noreferrer"' : '';
      return `<a href="${link}"${attrs}>${label}</a>`;
    },
  );
}
---

<article
  class={`project-card project-card-${variant}`}
  data-categories={(project.categories ?? []).join(' ')}
>
  {
    image && href && (
      <a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
        <img class="project-card-image" src={image} alt={project.title} loading="lazy" />
      </a>
    )
  }
  {
    image && !href && (
      <img class="project-card-image" src={image} alt={project.title} loading="lazy" />
    )
  }
  <div class="project-card-body">
    <div class="project-title-row">
      <h2 class="project-title">
        {href ? (
          <a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
            {project.title}
          </a>
        ) : (
          project.title
        )}
      </h2>
    </div>
    <p class="project-description" set:html={inlineMarkdownLinks(project.description)} />
    {project.tags && project.tags.length > 0 && <p class="project-tags">{project.tags.join(' · ')}</p>}
    {
      isAppStoreLink(project.link) && (
        <a class="project-card-appstore" href={project.link} target="_blank" rel="noopener noreferrer">
          <img src="/images/download-appstore.svg" alt={`Download ${project.title} on the App Store`} />
        </a>
      )
    }
  </div>
</article>
